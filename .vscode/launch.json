{
    "configurations": [
        {
            "type": "java",
            "name": "CoreGateway",
            "request": "launch",
            "mainClass": "com.exchange.coregateway.CoreGatewayApp",
            "projectName": "core-gateway",
            "vmArgs": "--add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-exports java.base/jdk.internal.misc=ALL-UNNAMED"
        },
        {
            "type": "java",
            "name": "Core",
            "request": "launch",
            "mainClass": "com.exchange.core.Runner",
            "projectName": "core",
            "vmArgs": "--add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-exports java.base/jdk.internal.misc=ALL-UNNAMED"
        },
        {
            "type": "java",
            "name": "OMS",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "com.exchange.oms.OMS",
            "projectName": "oms",
            "args": "",
            "envFile": "${workspaceFolder}/.env",
            "vmArgs": "-Dspring.profiles.active=dev"
        },
        {
            "type": "java",
            "name": "Profile",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "com.exchange.profile.ProfileApp",
            "projectName": "profile",
            "args": "",
            "envFile": "${workspaceFolder}/.env",
            "vmArgs": "-Dspring.profiles.active=dev"
        }
    ]
}