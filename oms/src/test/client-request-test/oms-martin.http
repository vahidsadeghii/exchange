###User Signin
POST http://{{host}}/profile/open/v1/user/signin
Content-Type: application/json

{
    "userName": "martin.hoffmann@example.com",
  "password": "hoffmanmartinSecretPass123!"
}
> {%
    client.test("Status code is 200", function () {
        client.assert(response.status === 200, "Expected status 200");
    });

    client.test("Access token exists", function () {
        client.assert(response.body.accessToken !== undefined, "Missing accessToken object");
        client.assert(response.body.accessToken.accessToken !== "", "accessToken is empty");
    });

    client.test("Access token expiration exists", function () {
        client.assert(response.body.accessToken.expirationDate !== "", "accessToken expiration missing");
    });

    client.test("Refresh token exists", function () {
        client.assert(response.body.refreshToken !== undefined, "Missing refreshToken object");
        client.assert(response.body.refreshToken.refreshToken !== "", "refreshToken is empty");
    });

    client.test("Refresh token expiration exists", function () {
        client.assert(response.body.refreshToken.expirationDate !== "", "refreshToken expiration missing");
    });

    client.test("User type is returned", function () {
        client.assert(response.body.userType !== undefined, "userType missing");
    });

    client.global.set("loginToken", response.body.accessToken.accessToken);

%}



### Create Order
POST http://{{host}}/oms/api/v1/orders
Authorization: Bearer {{loginToken}}
Content-Type: application/json
Request-Id: 2002

{
  "assetType": "EUR",
  "tradePair": "BTC_EURO",
  "orderType": "LIMIT",
  "tradeSide": "SELL",
  "marketType": "SPOT",
  "quantity": 0.5,
  "price": 2306.75,
  "expireDays": 3
}

> {%
    client.log("Status: " + response.status);
    client.log("Body: " + JSON.stringify(response.body));

    if (response.status !== 200) {
        client.log("Request failed with status " + response.status);
    } else {
        client.test("Status code is 200", function () {
            client.assert(response.status === 200);
        });

        client.test("Order ID exists", function () {
            client.assert(response.body.id !== undefined);
        });

        client.test("Trade pair is correct", function () {
            client.assert(response.body.tradePair === "BTC_EURO");
        });

        client.test("Trade side is SELL", function () {
            client.assert(response.body.tradeSide === "SELL");
        });

        client.test("Order type is LIMIT", function () {
            client.assert(response.body.orderType === "LIMIT");
        });

        client.test("Quantity is correct", function () {
            client.assert(response.body.quantity == 0.5);
        });

        client.test("Price is correct", function () {
            client.assert(response.body.price == 2000.75);
        });

        client.test("CreatedAt exists", function () {
            client.assert(response.body.createDate !== undefined);
        });

        client.log("Created order id = " + response.body.id);
    }
%}

