####### Create Order
POST http://{{host}}/oms/api/v1/orders
Authorization: Bearer {{loginToken}}
Content-Type: application/json
Request-Id: test-order-{{$timestamp}}

{
  "assetType": "EUR",
  "tradePair": "BTC_EURO",
  "orderType": "MARKET",
  "tradeSide": "SELL",
  "marketType": "SPOT",
  "quantity": 0.5,
  "price": 1560.75,
  "expireDays": 7
}

> {%
client.log("HTTP Status: " + response.status);
client.log("Response Body: " + JSON.stringify(response.body));

// Always handle rate limiting first
if (response.status === 429) {
    client.log("429 Too Many Requests - backend rate limit triggered");
}
else if (response.status === 200 && response.body) {

    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Order ID exists", function () {
        client.assert(response.body.id !== undefined);
    });

    client.test("Trade pair correct", function () {
        client.assert(response.body.tradePair === "BTC_EURO");
    });

    client.test("Trade side correct", function () {
        client.assert(response.body.tradeSide === "SELL");
    });

    client.test("Order type correct", function () {
        client.assert(response.body.orderType === "LIMIT");
    });

    client.test("Quantity correct", function () {
        client.assert(response.body.quantity == 0.5);
    });

    client.test("Price correct", function () {
        client.assert(response.body.price == 1800.75);
    });

    client.test("CreatedAt exists", function () {
        client.assert(response.body.createDate !== undefined);
    });

    client.global.set("orderId", response.body.id);
    client.log("Saved orderId = " + response.body.id);

}
else {
    client.log("Request failed. Status: " + response.status);
}
%}


#####Update Order three
POST http://{{host}}/oms/api/v1/orders
Authorization: Bearer {{loginToken}}
Content-Type: application/json
Request-Id: 2001

{
  "oldOrderId": {{orderId}},
  "assetType": "EUR",
  "tradePair": "BTC_EURO",
  "orderType": "MARKET",
  "tradeSide": "SELL",
  "marketType": "SPOT",
  "quantity": 0.5,
  "price": 1300.75
}

> {%
    const body = response.body;

    client.test("Status code is 200", function () {
        client.assert(response.status === 200,
            "Expected 200 but got " + response.status);
    });

    client.test("Order ID exists", function () {
        client.assert(body.id !== undefined,
            "Order id is missing");
    });

    client.test("Trade pair is correct", function () {
        client.assert(body.tradePair === "BTC_EURO",
            "Trade pair mismatch");
    });

    client.test("Trade side is BUY", function () {
        client.assert(body.tradeSide === "BUY",
            "Trade side mismatch");
    });

    client.test("Order type is LIMIT", function () {
        client.assert(body.orderType === "LIMIT",
            "Order type mismatch");
    });

    client.test("Quantity is correct", function () {
        client.assert(body.quantity == 0.5,
            "Quantity mismatch");
    });

    client.test("Price is correct", function () {
        client.assert(body.price == 2300.75,
            "Price mismatch");
    });

    client.test("CreatedAt exists", function () {
        client.assert(body.createDate !== undefined,
            "createDate missing");
    });

    client.log("Created order id = " + body.id);
%}


### Get Order Book Depth
GET http://{{host}}/oms/api/v1/orderdepth?pair=BTC_EURO&depth=2
Authorization: Bearer {{loginToken}}
Content-Type: application/json
Request-Id: 2002

> {%
client.test("Status is 200", function () {
    client.assert(response.status === 200, "Expected status 200");
});

client.test("Response contains bids", function () {
    client.assert(response.body.bids != null, "bids should not be null");
});

client.test("Response contains asks", function () {
    client.assert(response.body.asks != null, "asks should not be null");
});

client.test("Bids and asks are arrays", function () {
    client.assert(Array.isArray(response.body.bids), "bids should be an array");
    client.assert(Array.isArray(response.body.asks), "asks should be an array");
});

client.test("Depth does not exceed requested value", function () {
    client.assert(response.body.bids.length <= 10, "Too many bids");
    client.assert(response.body.asks.length <= 10, "Too many asks");
});
%}