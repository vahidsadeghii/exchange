### ===========================================
### SELLER LOGIN
### ===========================================

POST http://{{host}}/profile/open/v1/user/signin
Content-Type: application/json

{
  "userName": "martin.hoffmann@example.com",
  "password": "hoffmanmartinSecretPass123!"
}

> {%

client.test("Login Success", function () {
    client.assert(response.status === 200);
});

client.global.set("sellerToken", response.body.accessToken.accessToken);

client.log("Seller logged in");

%}



### ===========================================
### SELL LIMIT ORDER #1
### ===========================================

POST http://{{host}}/oms/api/v1/orders
Authorization: Bearer {{sellerToken}}
Content-Type: application/json
Request-Id: {{$uuid}}

{
  "assetType":"EUR",
  "tradePair":"BTC_EURO",
  "orderType":"LIMIT",
  "tradeSide":"SELL",
  "marketType":"SPOT",
  "quantity":1,
  "price":1200,
  "expireDays":7
}

> {%

client.test("Status 200",function(){
    client.assert(response.status===200);
});

client.test("TradeSide SELL",function(){
    client.assert(response.body.tradeSide==="SELL");
});

client.test("OrderType LIMIT",function(){
    client.assert(response.body.orderType==="LIMIT");
});

client.test("Price Correct",function(){
    client.assert(response.body.price==1200);
});

client.global.set("sellOrder1",response.body.id);

client.log("SELL ORDER="+response.body.id);

%}



