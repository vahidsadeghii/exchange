### ===========================================
### MARKET SELL
### ===========================================

POST http://{{host}}/oms/api/v1/orders
Authorization: Bearer {{sellerToken}}
Content-Type: application/json
Request-Id: {{$uuid}}

{
  "assetType":"EUR",
  "tradePair":"BTC_EURO",
  "orderType":"MARKET",
  "tradeSide":"SELL",
  "marketType":"SPOT",
  "quantity":0.5,
  "price":0
}

> {%

client.test("Status 200",function(){
    client.assert(response.status===200);
});

client.test("OrderType MARKET",function(){
    client.assert(response.body.orderType==="MARKET");
});

client.test("TradeSide SELL",function(){
    client.assert(response.body.tradeSide==="SELL");
});

client.global.set("marketSellId",response.body.id);

%}



