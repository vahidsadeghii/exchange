### ===========================================
### UPDATE SELL ORDER
### ===========================================

POST http://{{host}}/oms/api/v1/orders
Authorization: Bearer {{sellerToken}}
Content-Type: application/json
Request-Id: {{$uuid}}

{
  "oldOrderId": {{sellOrder1}},
  "assetType":"EUR",
  "tradePair":"BTC_EURO",
  "orderType":"LIMIT",
  "tradeSide":"SELL",
  "marketType":"SPOT",
  "quantity":1,
  "price":1300
}

> {%

client.test("Status 200",function(){
    client.assert(response.status===200);
});

client.test("TradeSide SELL",function(){
    client.assert(response.body.tradeSide==="SELL");
});

client.test("Updated Price",function(){
    client.assert(response.body.price==1300);
});

client.global.set("updatedSellOrder",response.body.id);

%}



### ===========================================
### CHECK ORDERBOOK
### ===========================================

GET http://{{host}}/oms/api/v1/orderdepth?pair=BTC_EURO&depth=5
Authorization: Bearer {{sellerToken}}
Request-Id: {{$uuid}}

> {%

client.test("Depth OK",function(){
    client.assert(response.status===200);
});

client.test("Has Bids",function(){
    client.assert(Array.isArray(response.body.bids));
});

client.test("Has Asks",function(){
    client.assert(Array.isArray(response.body.asks));
});

client.test("Depth <=5",function(){
    client.assert(response.body.bids.length<=5);
    client.assert(response.body.asks.length<=5);
});

if(response.body.bids.length>0){
    client.log("Best Bid="+response.body.bids[0].price);
}

if(response.body.asks.length>0){
    client.log("Best Ask="+response.body.asks[0].price);
}

client.log("Seller tests finished.");

%}