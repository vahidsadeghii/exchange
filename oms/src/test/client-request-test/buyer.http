    client.assert(response.body.tradeSide==="BUY");
});

client.test("Quantity Correct",function(){
    client.assert(response.body.quantity==0.5);
});

client.global.set("marketBuyId",response.body.id);

client.log("MARKET BUY = "+response.body.id);

%}



