### ===========================================
### SECOND LIMIT BUY (Partial Fill Scenario)
### ===========================================

POST http://{{host}}/oms/api/v1/orders
Authorization: Bearer {{buyerToken}}
Content-Type: application/json
Request-Id: {{$uuid}}

{
  "assetType":"EUR",
  "tradePair":"BTC_EURO",
  "orderType":"LIMIT",
  "tradeSide":"BUY",
  "marketType":"SPOT",
  "quantity":2,
  "price":1200
}

> {%

client.test("Status 200",function(){
    client.assert(response.status===200);
});

client.test("LIMIT BUY",function(){
    client.assert(response.body.orderType==="LIMIT");
});

client.test("Quantity 2",function(){
    client.assert(response.body.quantity==2);
});

client.test("Price 1200",function(){
    client.assert(response.body.price==1200);
});

client.global.set("partialBuyId",response.body.id);

%}



### ===========================================
### VERIFY ORDERBOOK
### ===========================================

GET http://{{host}}/oms/api/v1/orderdepth?pair=BTC_EURO&depth=5
Authorization: Bearer {{buyerToken}}
Request-Id: {{$uuid}}

> {%

client.test("Depth OK",function(){
    client.assert(response.status===200);
});

client.test("Bids Array",function(){
    client.assert(Array.isArray(response.body.bids));
});

client.test("Asks Array",function(){
    client.assert(Array.isArray(response.body.asks));
});

client.test("Depth <=5",function(){
    client.assert(response.body.bids.length<=5);
    client.assert(response.body.asks.length<=5);
});

if(response.body.bids.length>0){
    client.log("Best Bid = "+response.body.bids[0].price);
}

if(response.body.asks.length>0){
    client.log("Best Ask = "+response.body.asks[0].price);
}

client.log("Buyer tests finished.");

%}