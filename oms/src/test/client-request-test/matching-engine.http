###############################################################
### SCENARIO 6
### MARKET DEPTH
###############################################################

GET http://{{host}}/oms/api/v1/orderdepth?pair=BTC_EURO&depth=5
Authorization: Bearer {{buyerToken}}

> {%

client.test("Depth",function(){

client.assert(response.status==200);

client.assert(Array.isArray(response.body.bids));

client.assert(Array.isArray(response.body.asks));

client.assert(response.body.bids.length<=5);

client.assert(response.body.asks.length<=5);

});

client.log("Matching Engine regression completed.");

%}