###############################################################
### LOGIN BUYER
###############################################################

POST http://{{host}}/profile/open/v1/user/signin
Content-Type: application/json

{
  "userName":"helda.musterman11@example.com",
  "password":"HeldaPass123!"
}

> {%
client.assert(response.status==200);
client.global.set("buyerToken",response.body.accessToken.accessToken);
%}



###############################################################
### LOGIN SELLER
###############################################################

POST http://{{host}}/profile/open/v1/user/signin
Content-Type: application/json

{
  "userName":"martin.hoffmann@example.com",
  "password":"hoffmanmartinSecretPass123!"
}

> {%
client.assert(response.status==200);
client.global.set("sellerToken",response.body.accessToken.accessToken);
%}



###############################################################
### SCENARIO 1
### FULL MATCH
###############################################################

### SELL LIMIT

POST http://{{host}}/oms/api/v1/orders
Authorization: Bearer {{sellerToken}}
Content-Type: application/json
Request-Id: {{$uuid}}

{
 "assetType":"EUR",
 "tradePair":"BTC_EURO",
 "orderType":"LIMIT",
 "tradeSide":"SELL",
 "marketType":"SPOT",
 "quantity":1,
 "price":1000
}

> {%
client.global.set("sell1",response.body.id);
%}



### BUY LIMIT

POST http://{{host}}/oms/api/v1/orders
Authorization: Bearer {{buyerToken}}
Content-Type: application/json
Request-Id: {{$uuid}}

{
 "assetType":"EUR",
 "tradePair":"BTC_EURO",
 "orderType":"LIMIT",
 "tradeSide":"BUY",
 "marketType":"SPOT",
 "quantity":1,
 "price":1000
}

> {%

client.test("Matched",function(){
client.assert(response.status==200);
});

client.global.set("buy1",response.body.id);

%}



###############################################################
### ORDERBOOK SHOULD BE EMPTY
###############################################################

GET http://{{host}}/oms/api/v1/orderdepth?pair=BTC_EURO&depth=5
Authorization: Bearer {{buyerToken}}

> {%

client.test("Book Empty",function(){

client.assert(response.body.bids.length==0);

client.assert(response.body.asks.length==0);

});

%}



