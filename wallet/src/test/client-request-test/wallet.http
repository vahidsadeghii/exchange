### Find transactions by wallet-id
POST http://localhost:8070/wallet/api/v1/transactions?walletId=3f26adbd-114d-4da3-a61f-c90c89ce8b75
Authorization: Bearer {{loginToken}}
Request-Id: 1009
Content-Type: application/json

{}

> {%
    if (response.status === 429) {

        client.test("Rate limit is active", function () {
            client.assert(true, "429 received - rate limiter is working");
        });

        client.log("Skipping body assertions due to 429");

    } else {

        client.test("Success response", function () {
            client.assert(response.status >= 200 && response.status < 300);
        });

        client.test("Response is array", function () {
            client.assert(Array.isArray(response.body),
                "Expected array response");
        });
    }
%}

