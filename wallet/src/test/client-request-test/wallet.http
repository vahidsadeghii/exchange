###User Signin
POST http://{{host}}/profile/open/v1/user/signin
Content-Type: application/json

{
  "userName": "helda.musterman11@example.com",
  "password": "HeldaPass123!"
}
> {%
    client.test("Status code is 200", function () {
        client.assert(response.status === 200, "Expected status 200");
    });

    client.test("Access token exists", function () {
        client.assert(response.body.accessToken !== undefined, "Missing accessToken object");
        client.assert(response.body.accessToken.accessToken !== "", "accessToken is empty");
    });

    client.test("Access token expiration exists", function () {
        client.assert(response.body.accessToken.expirationDate !== "", "accessToken expiration missing");
    });

    client.test("Refresh token exists", function () {
        client.assert(response.body.refreshToken !== undefined, "Missing refreshToken object");
        client.assert(response.body.refreshToken.refreshToken !== "", "refreshToken is empty");
    });

    client.test("Refresh token expiration exists", function () {
        client.assert(response.body.refreshToken.expirationDate !== "", "refreshToken expiration missing");
    });

    client.test("User type is returned", function () {
        client.assert(response.body.userType !== undefined, "userType missing");
    });

    client.global.set("loginToken", response.body.accessToken.accessToken);

%}



###update Wallet
POST http://{{host}}/wallet/api/v1/user/wallet
Authorization: Bearer {{loginToken}}
Request-Id:  1001
Content-Type: application/json

{
  "assets": [
    {
      "balance": 0,
      "blockedBalance": 0,
      "assetType": "BTC"
    },
    {
      "balance": 0,
      "blockedBalance": 0,
      "assetType": "ETH"
    },
    {
      "balance": 1000,
      "blockedBalance": 0,
      "assetType": "USDT"
    },
    {
      "balance": 500,
      "blockedBalance": 0,
      "assetType": "EUR"
    },
    {
      "balance": 250,
      "blockedBalance": 0,
      "assetType": "USD"
    }
  ]
}

> {%
    client.log("STATUS = " + response.status);

    client.test("Status code is 200", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });

    if (response.status === 200 && response.body && response.body.assets) {

        client.test("Assets exist", function () {
            client.assert(response.body.assets.length > 0, "assets empty");
        });

        client.test("BTC exists", function () {
            client.assert(
                response.body.assets.some(a => a.assetType === "BTC"),
                "BTC missing"
            );
        });

    }
%}

###User Wallet Info
GET http://{{host}}/wallet/api/v1/user/wallet-info/assetType?assetType=BTC
Authorization: Bearer {{loginToken}}
Request-Id: 1001
Accept: application/json

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
    });

    client.test("Wallet ID exists", function () {
        client.assert(response.body.walletId != null, "walletId is missing");
    });

    client.test("Asset type is BTC", function () {
        client.assert(response.body.assetType === "BTC",
            "Expected assetType to be BTC");
    });

    client.test("Balance exists", function () {
        client.assert(response.body.balance != null,
            "balance is missing");
    });

    client.test("Balance is non-negative", function () {
        client.assert(response.body.balance >= 0,
            "balance should be >= 0");
    });


    client.global.set("walletId", response.body.walletId);
%}


### Deposit Wallet
POST http://{{host}}/wallet/api/v1/user/deposit
Authorization: Bearer {{loginToken}}
Request-Id: 1001
Content-Type: application/json

{
  "walletId": "{{walletId}}",
  "assetType": "BTC",
  "amount": 1000
}

> {%
    client.test("Status is 200", function () {
        client.assert(response.status === 200);
    });

    client.test("Wallet ID matches", function () {
        client.assert(response.body.walletId === client.global.get("walletId"));
    });

    client.test("BTC asset exists", function () {
        const btc = response.body.asserts.find(a => a.assetType === "BTC");
        client.assert(btc != null, "BTC asset not found");
    });

    client.test("BTC balance increased", function () {
        const btc = response.body.asserts.find(a => a.assetType === "BTC");

        const oldBalance = parseFloat(client.global.get("oldBalance"));
        const newBalance = parseFloat(btc.balance);

        client.assert(
            newBalance >= oldBalance + 1000,
            `Expected balance >= ${oldBalance + 1000}, actual ${newBalance}`
        );
    });

    client.log("STATUS = " + response.status);
    client.log(JSON.stringify(response.body, null, 2));
%}
